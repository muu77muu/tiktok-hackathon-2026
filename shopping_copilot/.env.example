# Optional prototype services. The official evaluator-facing Agent needs none.

APP_ENV=development
DEBUG=true

# Optional OpenAI-compatible chat endpoint
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-4-31b-it
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Optional Supabase-backed prototype routes
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Optional local embedding/reranking experiments
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=
